# Token Lifespans (in seconds)
ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=604800    # 7 days

# OTP Settings
OTP_TTL_SECONDS=300                 # 5 minutes
OTP_ATTEMPT_LIMIT=5                 # Max 5 wrong attempts per challenge
OTP_RATE_LIMIT_SECONDS=900          # 15 minute window for rate limiting
OTP_MAX_CHALLENGES_PER_WINDOW=3     # Max 3 challenges per destination per window
HMAC_SECRET_KEY=dev_hmac_fingerprint_secret_key_32bytes!

# Idempotency Response Encryption Key (Fernet 32-byte urlsafe base64)
IDEMPOTENCY_ENCRYPTION_KEY=gAAAAABlZGV2X2tleV9mb3JfaWRlbXBvdGVuY3lfZW5jcnlwdGlvbg==

# Object Storage (MinIO local / S3 production - Foundation Spec §11, Integration Spec §14)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=karobarone-media
S3_REGION=us-east-1
